# ============================================================
# 智能客服多 Agent 系统 — 配置文件
# 复制为 .env 并填入实际值
# ============================================================

# ── 服务 ──
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── LLM 提供商 ──
# 支持: deepseek, doubao, qwen, openai
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ── Embedding ──
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_MAX_CHARS=180

# ── Reranker ──
RAG_RERANKER_BASE_URL=
RAG_RERANKER_API_KEY=
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── RAG 参数 ──
RAG_TOP_K=12
RAG_TOP_N=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# ── Chroma 向量库 ──
CHROMA_PERSIST_DIR=./vector_store/chroma
KB_DIR=./knowledge_base

# ── MySQL ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_service
MYSQL_POOL_SIZE=5

# ── 知识库启动策略 ──
KB_BUILD_ON_STARTUP=false
KB_SEED_ON_STARTUP=true

# ── 短期记忆 ──
STM_MAX_ROUNDS=20
# 可选的 Markdown 持久化目录（为空则不启用，会话记录仅保留在内存中）
STM_MD_DIR=

# ── 工作记忆 ──
WM_MAX_RECORDS=50

# ── 合规 ──
COMPLIANCE_ENABLED=true

# ── 可观测性 ──
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
